{
  "name": "tripplan-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de TripPlan para Hito 3 y su futuro cliente móvil",
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && concurrently -k -n types,api \"tsc --watch -p tsconfig.json --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.spec.js",
    "migration:run": "npm run build && node node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build && node node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
    "seed": "npm run build && node dist/database/seed.js",
    "smoke": "node scripts/smoke.mjs",
    "env:setup": "node scripts/setup-env.mjs",
    "openapi": "npm run build && node scripts/export-openapi.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.18.0",
    "pg-mem": "^3.0.5",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0"
  }
}
